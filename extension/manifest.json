{
  "manifest_version": 3,
  "name": "Wikipedia Fact Check",
  "version": "0.1.0",
  "description": "Fact-check a selection or the loaded article against Wikipedia.",
  "permissions": ["contextMenus", "sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Wikipedia Fact Check" }
}
