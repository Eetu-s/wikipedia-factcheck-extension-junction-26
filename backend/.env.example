DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DEBUG shows RAG search distances in the console. Defaults to DEBUG when DJANGO_DEBUG=1, else INFO.
# LOG_LEVEL=INFO
# Generate with:
#   docker compose run --rm backend python manage.py shell -c "from django.contrib.auth.hashers import make_password; print(make_password('your-password'))"
# Keep the single quotes: the hash contains '$', which Docker Compose would otherwise treat as a variable.
FACTCHECK_PASSWORD_HASH='pbkdf2_sha256$...'
# Google Gemini API key for the fact-check decision model (https://aistudio.google.com).
GEMINI_API_KEY=
